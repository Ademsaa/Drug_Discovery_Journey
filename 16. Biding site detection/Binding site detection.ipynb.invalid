   ],
   "source": [
    "from IPython.display import IFrame\n",
    "import tempfile, os\n",
    "\n",
    "html_content = view._make_html()          # generate the HTML\n",
    "tmp = tempfile.NamedTemporaryFile(suffix=\".html\", delete=False)\n",
    "tmp.write(html_content.encode())\n",
    "tmp.close()\n",
    "IFrame(tmp.name, width=820, height=520)   # render in an iframe — always works"
   ]

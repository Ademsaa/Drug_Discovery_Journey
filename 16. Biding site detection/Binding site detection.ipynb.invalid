    }
   ],
   "source": [
    "import requests, gzip, py3Dmol\n",
    "\n",
    "# --- Pocket volume (same as before) ---\n",
    "r = requests.get(selected_pocket_volume_url)\n",
    "r.raise_for_status()\n",
    "ccp4_str = gzip.decompress(r.content).decode(\"latin-1\")\n",
    "\n",
    "# --- Viewer: use query= to fetch PDB automatically ---\n",
    "view = py3Dmol.view(query=f\"pdb:{pdb_id}\", width=800, height=500)\n",
    "view.setStyle({}, {\"cartoon\": {\"color\": \"spectrum\"}})\n",
    "view.addStyle({\"hetflag\": True}, {\"sphere\": {\"scale\": 0.35}})\n",
    "\n",
    "# --- Add pocket volume ---\n",
    "view.addVolumetricData(ccp4_str, \"ccp4\", {\"isoval\": 0.5, \"color\": \"blue\", \"opacity\": 0.65})\n",
    "view.zoomTo()\n",
    "view  # <-- last line of cell, not view.show()"
   ]
  },

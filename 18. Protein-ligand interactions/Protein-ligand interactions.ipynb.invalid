  {
   "cell_type": "markdown",
   "id": "1d0c710e",
   "metadata": {},
   "source": [
    "### II.4 Visualization with py3dmol"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "7aae27e5",
   "metadata": {},
   "source": [
    "Now, let's try to represent those interactions in the py3Dmol viewer. We can draw cylinders between the interaction points (`LIGCOO` and `PROTCOO` in the `pandas.DataFrame`) and color-code them as shown in `color_map`, which uses RGB tuples."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 14,
   "id": "56a0a919",
   "metadata": {
    "tags": []
   },
   "outputs": [],
   "source": [
    "color_map = {\n",
    "    \"hydrophobic\": [0.90, 0.10, 0.29],\n",
    "    \"hbond\": [0.26, 0.83, 0.96],\n",
    "    \"waterbridge\": [1.00, 0.88, 0.10],\n",
    "    \"saltbridge\": [0.67, 1.00, 0.76],\n",
    "    \"pistacking\": [0.75, 0.94, 0.27],\n",
    "    \"pication\": [0.27, 0.60, 0.56],\n",
    "    \"halogen\": [0.94, 0.20, 0.90],\n",
    "    \"metal\": [0.90, 0.75, 1.00],\n",
    "}"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "f5104639",
   "metadata": {},
   "source": [
    "Let's see what these RGB colors correspond to:"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 15,
   "id": "e2d55c63",
   "metadata": {
    "tags": [
     "nbsphinx-thumbnail"
    ]
   },
   "outputs": [
    {
     "data": {
      "image/png": "",
      "text/plain": [
       "<Figure size 1500x200 with 8 Axes>"
      ]
     },
     "metadata": {},
     "output_type": "display_data"
    }
   ],
   "source": [
    "fig, axs = plt.subplots(nrows=2, ncols=4, figsize=(15, 2))\n",
    "plt.subplots_adjust(hspace=1)\n",
    "fig.suptitle(\"Colors for interaction types\", size=16, y=1.2)\n",
    "\n",
    "for ax, (interaction, color) in zip(fig.axes, color_map.items()):\n",
    "    ax.imshow(np.zeros((1, 5)), cmap=colors.ListedColormap(color_map[interaction]))\n",
    "    ax.set_title(interaction, loc=\"center\")\n",
    "    ax.set_axis_off()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "586b90bc",
   "metadata": {},
   "source": [
    "Define a helper function to show the interactions."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "554dab14",
   "metadata": {
    "tags": []
   },
   "outputs": [],
   "source": [
    "def show_interactions_3d(\n",
    "    pdb_id, selected_site_interactions, highlight_interaction_colors=color_map\n",
    "):\n",
    "    \"\"\"\n",
    "    3D visualization of protein-ligand interactions.\n",
    "\n",
    "    Parameters\n",
    "    ----------\n",
    "    pdb_id : str\n",
    "        The pdb ID of interest.\n",
    "    selected_site_interactions : dict\n",
    "        Precalculated interactions from PLIP for the selected site.\n",
    "    highlight_interaction_colors : dict\n",
    "        The colors used to highlight the different interaction types.\n",
    "\n",
    "    Returns\n",
    "    -------\n",
    "    py3Dmol viewer with explicit interactions given by PLIP.\n",
    "    \"\"\"\n",
    "    import py3Dmol\n",
    "    import requests\n",
    "\n",
    "    # Fetch PDB structure\n",
    "    url = f\"https://files.rcsb.org/download/{pdb_id.upper()}.pdb\"\n",
    "    pdb_data = requests.get(url).text\n",
    "\n",
    "    # Create viewer\n",
    "    viewer = py3Dmol.view(width=800, height=600)\n",
    "    viewer.addModel(pdb_data, \"pdb\")\n",
    "\n",
    "    # Style: cartoon for protein, sticks for heteroatoms (ligands), hide water\n",
    "    viewer.setStyle({\"cartoon\": {\"color\": \"spectrum\"}})\n",
    "    viewer.setStyle({\"hetflag\": True}, {\"stick\": {}})\n",
    "    viewer.setStyle({\"resn\": \"HOH\"}, {})  # hide water\n",
    "\n",
    "    interacting_residues = []\n",
    "\n",
    "    for interaction_type, interaction_list in selected_site_interactions.items():\n",
    "        rgb = highlight_interaction_colors[interaction_type]\n",
    "        # Convert [0-1] float RGB to hex string\n",
    "        hex_color = \"#{:02x}{:02x}{:02x}\".format(\n",
    "            int(rgb[0] * 255), int(rgb[1] * 255), int(rgb[2] * 255)\n",
    "        )\n",
    "        if len(interaction_list) == 1:\n",
    "            continue\n",
    "        df_interactions = pd.DataFrame.from_records(\n",
    "            interaction_list[1:], columns=interaction_list[0]\n",
    "        )\n",
    "        for _, interaction in df_interactions.iterrows():\n",
    "            lig_coo = interaction[\"LIGCOO\"]   # (x, y, z) tuple or list\n",
    "            prot_coo = interaction[\"PROTCOO\"] # (x, y, z) tuple or list\n",
    "\n",
    "            # Draw cylinder between ligand and protein atom\n",
    "            viewer.addCylinder(\n",
    "                {\n",
    "                    \"start\": {\"x\": lig_coo[0],  \"y\": lig_coo[1],  \"z\": lig_coo[2]},\n",
    "                    \"end\":   {\"x\": prot_coo[0], \"y\": prot_coo[1], \"z\": prot_coo[2]},\n",
    "                    \"radius\": 0.1,\n",
    "                    \"color\": hex_color,\n",
    "                    \"label\": interaction_type,\n",
    "                }\n",
    "            )\n",
    "            interacting_residues.append(int(interaction[\"RESNR\"]))\n",
    "\n",
    "    # Highlight interacting residues as sticks\n",
    "    for resnr in set(interacting_residues):\n",
    "        viewer.setStyle(\n",
    "            {\"resi\": resnr, \"atom\": [\"C\", \"N\", \"O\", \"S\"]},\n",
    "            {\"stick\": {\"colorscheme\": \"chainHetatm\", \"radius\": 0.2}},\n",
    "        )\n",
    "\n",
    "    # Center on ligand (heteroatoms, excluding water)\n",
    "    viewer.zoomTo({\"hetflag\": True})\n",
    "    viewer.show()\n",
    "    return viewer"
   ]
  },
